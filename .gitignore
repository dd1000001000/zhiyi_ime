.vs/
.vscode/
*.user
*.suo

# Compiled objects (in-source, should not happen)
*.o
*.obj
*.slo
*.lo

# Python
__pycache__/
*.pyc

# Claude Code
CLAUDE.md
.claude/

# OS
Thumbs.db
Desktop.ini

# ---- 知意输入法 ----
