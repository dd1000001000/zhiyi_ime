{
    "schema": {
        "name": "Zhiyi IME",
        "version": "1.0",
        "description": "Zhiyi IME default configuration"
    },
    "engine": {
        "page_size": 7,
        "max_pinyin_length": 64,
        "pinyin_scheme": "full_pinyin",
        "wubi_auto_commit": true,
        "wubi_commit_first_on_fifth_key": true,
        "wubi_restart_on_fifth_after_miss": true,
        "wubi_code_hint": false,
        "candidate_learning": true,
        "pinyin_initials": false,
        "fuzzy_pinyin": false,
        "fuzzy_groups": ["z_zh", "c_ch", "s_sh", "n_l", "an_ang", "en_eng", "in_ing"]
    },
    "initial_state": {
        "full_shape": false,
        "chinese_punct": true
    },
    "style": {
        "font_face": "Microsoft YaHei UI",
        "font_point": 14,
        "layout": "horizontal",
        "render_backend": "d2d",
        "candidate_count": 7,
        "inline_preedit": true,
        "preedit_type": "composition"
    },
    "layout": {
        "min_width": 160,
        "max_width": 0,
        "min_height": 0,
        "max_height": 0,
        "margin_x": 12,
        "margin_y": 12,
        "spacing": 10,
        "candidate_spacing": 11,
        "hilite_spacing": 4,
        "hilite_padding_x": 5,
        "hilite_padding_y": 2,
        "round_corner": 4,
        "round_corner_ex": 4,
        "label_font_point": 0,
        "border_width": 1,
        "preedit_highlight_padding_x": 4,
        "preedit_highlight_padding_y": 2,
        "preedit_confirmed_gap": 6,
        "preedit_boundary_gap": 1,
        "preedit_highlight_corner": 3,
        "preedit_highlight_border_width": 1
    },
    "ascii_composer": {
        "switch_key": {
            "Shift_L": "code",
            "Shift_R": "code",
            "Control_L": "noop",
            "Control_R": "noop",
            "Caps_Lock": "clear"
        }
    },
    "shortcuts": {
        "activate_ime": "disabled"
    },
    "theme": "moon_light",
    "ui": {
        "language": "auto"
    },
    "status_window": {
        "enable": true,
        "x": -1,
        "y": -1,
        "show_on_startup": true
    },
    "diagnostics": {
        "trace_mode": "off",
        "log_max_size": 8388608,
        "log_max_files": 4,
        "normal_sample_rate": 0,
        "truncated_sample_rate": 100,
        "slow_query_us": 30000,
        "cache_miss_slow_us": 10000,
        "slow_ipc_us": 2000,
        "slow_window_us": 5000,
        "slow_total_us": 10000
    }
}
