{
    "scheme_id": "full_pinyin",
    "speller": {
        "type": "full_pinyin",
        "algebra": [
            "abbrev/^([a-z]).+$/$1/",
            "abbrev/^([zcs]h).+$/$1/",
            "derive/^([nl])ve$/$1ue/",
            "derive/^([jqxy])u/$1v/",
            "derive/un$/uen/",
            "derive/ui$/uei/",
            "derive/iu$/iou/",
            "derive/([aeiou])ng$/$1gn/"
        ],
        "fuzzy_groups": [
            {
                "name": "z_zh",
                "bit": 1,
                "part": "initial",
                "rules": [
                    "fuzz/^zh/z/",
                    "fuzz/^z([^h]|$)/zh$1/"
                ]
            },
            {
                "name": "c_ch",
                "bit": 2,
                "part": "initial",
                "rules": [
                    "fuzz/^ch/c/",
                    "fuzz/^c([^h]|$)/ch$1/"
                ]
            },
            {
                "name": "s_sh",
                "bit": 4,
                "part": "initial",
                "rules": [
                    "fuzz/^sh/s/",
                    "fuzz/^s([^h]|$)/sh$1/"
                ]
            },
            {
                "name": "n_l",
                "bit": 8,
                "part": "initial",
                "rules": [
                    "fuzz/^n/l/",
                    "fuzz/^l/n/"
                ]
            },
            {
                "name": "an_ang",
                "bit": 16,
                "part": "final",
                "rules": [
                    "fuzz/ang$/an/",
                    "fuzz/an$/ang/"
                ]
            },
            {
                "name": "en_eng",
                "bit": 32,
                "part": "final",
                "rules": [
                    "fuzz/eng$/en/",
                    "fuzz/en$/eng/"
                ]
            },
            {
                "name": "in_ing",
                "bit": 64,
                "part": "final",
                "rules": [
                    "fuzz/ing$/in/",
                    "fuzz/in$/ing/"
                ]
            },
            {
                "name": "l_r",
                "bit": 128,
                "part": "initial",
                "rules": [
                    "fuzz/^l/r/",
                    "fuzz/^r/l/"
                ]
            },
            {
                "name": "f_h",
                "bit": 256,
                "part": "initial",
                "rules": [
                    "fuzz/^f/h/",
                    "fuzz/^h/f/"
                ]
            },
            {
                "name": "wang_huang",
                "bit": 512,
                "part": "syllable",
                "rules": [
                    "fuzz/^wang$/huang/",
                    "fuzz/^huang$/wang/"
                ]
            }
        ]
    }
}
